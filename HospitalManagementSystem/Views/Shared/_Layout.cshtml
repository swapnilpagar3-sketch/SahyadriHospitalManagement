@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sahyadri Super Speciality Hospital</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var role = User.FindFirstValue(ClaimTypes.Role) ?? "Patient";
        var userAvatar = User.FindFirst("ProfilePicture")?.Value ?? "/images/avatars/default.svg";
        var userName = User.Identity.Name ?? "User";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar" id="appSidebar">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                    <div class="bg-white rounded-3 px-3 py-2 w-100 d-flex justify-content-center align-items-center shadow-sm">
                        <img src="~/images/SahyadriLogo2.webp" alt="Sahyadri Hospital Logo" style="height: 50px; max-width: 100%; object-fit: contain;" />
                    </div>
                </a>

                <ul class="sidebar-menu">
                    <li class="menu-header">Core Operations</li>
                    <li class="menu-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="menu-link @(currentController == "Dashboard" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="menu-header">Clinical &amp; Patients</li>
                    <li class="menu-item">
                        <a asp-controller="Appointments" asp-action="Index" class="menu-link @(currentController == "Appointments" ? "active" : "")">
                            <i class="bi bi-calendar2-check"></i>
                            <span>Appointments</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a asp-controller="Patients" asp-action="Index" class="menu-link @(currentController == "Patients" ? "active" : "")">
                            <i class="bi bi-people"></i>
                            <span>Patients (रुग्ण)</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a asp-controller="Doctors" asp-action="Index" class="menu-link @(currentController == "Doctors" ? "active" : "")">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Specialists (डॉक्टर)</span>
                        </a>
                    </li>

                    <li class="menu-header">Specialized Wards &amp; Care</li>
                    <!-- Warden / Ward Management Module -->
                    <li class="menu-item">
                        <a asp-controller="Warden" asp-action="Index" class="menu-link @(currentController == "Warden" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-hospital"></i>
                            <span>Wards &amp; Beds (IPD)</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a asp-controller="Warden" asp-action="Admissions" class="menu-link @(currentController == "Warden" && currentAction == "Admissions" ? "active" : "")">
                            <i class="bi bi-door-open"></i>
                            <span>Bed Admissions</span>
                        </a>
                    </li>

                    <!-- Nurse Station Module -->
                    <li class="menu-item">
                        <a asp-controller="Nurse" asp-action="Index" class="menu-link @(currentController == "Nurse" ? "active" : "")">
                            <i class="bi bi-activity"></i>
                            <span>Nurse Station (Vitals)</span>
                        </a>
                    </li>

                    <!-- Prescriptions Module -->
                    <li class="menu-item">
                        <a asp-controller="Prescriptions" asp-action="Index" class="menu-link @(currentController == "Prescriptions" ? "active" : "")">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Prescriptions (औषध)</span>
                        </a>
                    </li>

                    <!-- Billing & Invoices Module -->
                    <li class="menu-item">
                        <a asp-controller="Billing" asp-action="Index" class="menu-link @(currentController == "Billing" ? "active" : "")">
                            <i class="bi bi-receipt"></i>
                            <span>Billing &amp; TPA (बिलिंग)</span>
                        </a>
                    </li>

                    <!-- Departments Module -->
                    <li class="menu-item">
                        <a asp-controller="Departments" asp-action="Index" class="menu-link @(currentController == "Departments" ? "active" : "")">
                            <i class="bi bi-building"></i>
                            <span>Departments (विभाग)</span>
                        </a>
                    </li>

                    <li class="menu-header">Hospital Policy</li>
                    <li class="menu-item">
                        <a asp-controller="Home" asp-action="Privacy" class="menu-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")">
                            <i class="bi bi-shield-lock"></i>
                            <span>Privacy &amp; DPDP Policy</span>
                        </a>
                    </li>
                </ul>

                <!-- User mini profile in Sidebar footer -->
                <div class="sidebar-user">
                    <img src="@userAvatar" alt="@userName" class="user-avatar-sm" />
                    <div class="overflow-hidden">
                        <div class="fw-bold text-truncate text-white small">@userName</div>
                        <span class="user-badge badge-@role">@role</span>
                    </div>
                </div>
            </aside>

            <!-- Main Workspace -->
            <div class="app-main">
                <!-- Topbar -->
                <header class="app-topbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-light border d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark d-none d-sm-block">
                                @ViewData["Title"]
                            </h5>
                            <span class="badge bg-warning-subtle text-dark border border-warning d-none d-md-inline-block small" style="font-size: 0.7rem;">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Sahyadri Hospital &bull; Pune Unit
                            </span>
                        </div>
                    </div>

                    <!-- Right Topbar Controls -->
                    <div class="d-flex align-items-center gap-3">
                        <a asp-controller="Appointments" asp-action="Create" class="btn btn-sm btn-primary-custom d-none d-md-inline-flex shadow-sm">
                            <i class="bi bi-plus-circle"></i> Book Appointment
                        </a>

                        <!-- Indian Emergency Quick Call Pill -->
                        <div class="emergency-quick-pill d-none d-lg-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger-subtle text-danger border border-danger fw-bold small">
                            <i class="bi bi-telephone-plus-fill fs-6 animate-pulse"></i>
                            <span>Emergency: 1066</span>
                        </div>

                        <!-- Notification Bell (Static / Aesthetic) -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-bell text-secondary"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="width: 300px;">
                                <li class="dropdown-header fw-bold text-dark border-bottom py-2">
                                    <i class="bi bi-hospital text-teal me-1"></i> Sahyadri Clinical Alerts
                                </li>
                                <li><a class="dropdown-item small py-2" href="#"><i class="bi bi-check-circle text-success me-2"></i>New patient registered</a></li>
                                <li><a class="dropdown-item small py-2" href="#"><i class="bi bi-hospital text-info me-2"></i>Bed ICU-02 disinfected</a></li>
                                <li><a class="dropdown-item small py-2" href="#"><i class="bi bi-shield-check text-warning me-2"></i>Ayushman Bharat claim approved</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small text-center text-teal fw-semibold" href="#">View all alerts</a></li>
                            </ul>
                        </div>

                        <!-- Top User Profile & Avatar Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-light d-flex align-items-center gap-2 border rounded-pill px-2 py-1 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@userAvatar" alt="@userName" class="user-avatar-sm" style="width: 34px; height: 34px;" />
                                <div class="text-start d-none d-md-block pe-1">
                                    <div class="small fw-bold text-dark lh-sm">@userName</div>
                                    <span class="user-badge badge-@role" style="font-size: 0.65rem; padding: 0.1rem 0.4rem;">@role</span>
                                </div>
                                <i class="bi bi-chevron-down small text-muted"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li class="px-3 py-2 border-bottom" style="background: linear-gradient(135deg, #f0fdfa, #fff7ed);">
                                    <div class="fw-bold text-dark">@userName</div>
                                    <div class="small text-muted text-truncate">@User.FindFirstValue(ClaimTypes.Email)</div>
                                    <span class="badge bg-teal text-white small mt-1">Sahyadri Hospital Pune</span>
                                </li>
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-teal"></i>My Profile &amp; Photo</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-event me-2 text-info"></i>My Appointments</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-check me-2 text-warning"></i>Privacy Policy</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Content Body -->
                <main class="app-content">
                    @RenderBody()
                </main>

                <!-- Authenticated App Footer with Hospital Address, Social Links, and Privacy Policy -->
                <footer class="bg-white border-top py-3 px-4 text-muted small">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                        <div>
                            <span class="fw-bold text-dark">Sahyadri Super Speciality Hospital</span> &bull; 
                            Plot No. 30-C, Erandwane, Karve Road, Pune - 411004, Maharashtra, India | 
                            <strong>24x7 Helpline:</strong> 1066 / +91 20 6721 5000
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <a asp-controller="Home" asp-action="Privacy" class="text-teal text-decoration-none fw-semibold">
                                <i class="bi bi-shield-lock me-1"></i> Privacy Policy
                            </a>
                            <div class="footer-social-icons d-inline-flex gap-2">
                                <a href="https://www.facebook.com/SahyadriHospitals/" target="_blank" rel="noopener noreferrer" class="social-btn facebook" title="Facebook"><i class="bi bi-facebook"></i></a>
                                <a href="https://www.instagram.com/sahyadri_hospitals/" target="_blank" rel="noopener noreferrer" class="social-btn instagram" title="Instagram"><i class="bi bi-instagram"></i></a>
                                <a href="https://twitter.com/SahyadriHosp" target="_blank" rel="noopener noreferrer" class="social-btn twitter" title="Twitter / X"><i class="bi bi-twitter-x"></i></a>
                                <a href="https://www.linkedin.com/company/sahyadri-hospitals-ltd/" target="_blank" rel="noopener noreferrer" class="social-btn linkedin" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Public Layout (Landing Page or Auth Pages) -->
        <!-- Top Indian Hospital Announcement Bar -->
        <div class="indian-hospital-topbar py-1 px-3 text-white small" style="background: linear-gradient(90deg, #ea580c 0%, #0f766e 100%);">
            <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold"><i class="bi bi-award-fill me-1"></i>NABH &amp; NABL ACCREDITED</span>
                    <span class="d-none d-md-inline text-white opacity-90">&bull; Pune's Largest Healthcare Network &bull; Ayushman Bharat (PM-JAY) Empanelled</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="d-none d-lg-inline text-light fst-italic">"सर्वे सन्तु निरामयाः" (May all be free from illness)</span>
                    <a href="tel:1066" class="text-white text-decoration-none fw-bold"><i class="bi bi-telephone-fill text-warning me-1"></i>Emergency 24x7: 1066 / +91 20 6721 5000</a>
                </div>
            </div>
        </div>

        <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-2 px-3 px-md-5 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center py-1" asp-controller="Home" asp-action="Index">
                    <img src="~/images/SahyadriLogo2.webp" alt="Sahyadri Super Speciality Hospital" height="65" style="object-fit: contain; max-width: 260px;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/#services">Specialties &amp; OPD</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/#doctors">Expert Doctors</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/#ayushman">Ayushman Bharat &amp; TPA</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-custom">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Staff / Patient Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom shadow-sm">
                            <i class="bi bi-person-plus me-1"></i> Register Account
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <!-- Rich Indian Hospital Footer with Address, Social Media Links & Privacy Policy -->
        <footer class="hospital-footer bg-dark text-light pt-5 pb-3 mt-auto">
            <div class="container">
                <div class="row g-4 mb-4">
                    <!-- Column 1: Hospital Overview -->
                    <div class="col-lg-4 col-md-6">
                        <div class="mb-3">
                            <div class="bg-white rounded-3 px-3 py-2 d-inline-block shadow-sm">
                                <img src="~/images/SahyadriLogo2.webp" alt="Sahyadri Hospital Logo" height="58" style="object-fit: contain; max-width: 240px;" />
                            </div>
                        </div>
                        <p class="text-light-50 small mb-3">
                            Sahyadri Super Speciality Hospital is Maharashtra’s largest chain of multi-speciality tertiary care hospitals, committed to delivering clinical excellence, modern medical technology, and compassionate patient care.
                        </p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-success-subtle text-success border border-success small"><i class="bi bi-shield-check me-1"></i>NABH Accredited</span>
                            <span class="badge bg-info-subtle text-info border border-info small"><i class="bi bi-check2-circle me-1"></i>NABL Diagnostics</span>
                            <span class="badge bg-warning-subtle text-warning border border-warning small"><i class="bi bi-heart me-1"></i>PM-JAY Empanelled</span>
                        </div>
                    </div>

                    <!-- Column 2: Units & Specialties in Maharashtra -->
                    <div class="col-lg-2 col-md-6">
                        <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 1px; color: #f97316 !important;">
                            Hospital Units
                        </h6>
                        <ul class="list-unstyled small text-light-50 footer-links">
                            <li><i class="bi bi-chevron-right me-1 text-warning"></i> Erandwane (Karve Rd), Pune</li>
                            <li><i class="bi bi-chevron-right me-1 text-warning"></i> Hadapsar Unit, Pune</li>
                            <li><i class="bi bi-chevron-right me-1 text-warning"></i> Kothrud Unit, Pune</li>
                            <li><i class="bi bi-chevron-right me-1 text-warning"></i> Nagar Road Unit, Pune</li>
                            <li><i class="bi bi-chevron-right me-1 text-warning"></i> Bibwewadi Unit, Pune</li>
                            <li><i class="bi bi-chevron-right me-1 text-warning"></i> Nashik &amp; Karad Units</li>
                        </ul>
                    </div>

                    <!-- Column 3: Hospital Address & Emergency Contacts (Requirement 3) -->
                    <div class="col-lg-3 col-md-6">
                        <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 1px; color: #f97316 !important;">
                            Hospital Address
                        </h6>
                        <div class="small text-light-50 mb-3">
                            <div class="d-flex align-items-start mb-2">
                                <i class="bi bi-geo-alt-fill text-warning me-2 fs-5 mt-1"></i>
                                <div>
                                    <strong class="text-white d-block">Sahyadri Super Speciality Hospital</strong>
                                    Plot No. 30-C, Erandwane, Karve Road, Deccan Gymkhana, Pune - 411004, Maharashtra, India.
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-telephone-fill text-danger me-2 fs-6"></i>
                                <div>
                                    <strong class="text-white">Emergency (24x7):</strong> 1066 / +91 20 6721 5000
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-whatsapp text-success me-2 fs-6"></i>
                                <div>
                                    <strong class="text-white">OPD Helpline:</strong> +91 88888 22222
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-envelope-fill text-info me-2 fs-6"></i>
                                <div>
                                    <strong class="text-white">Email:</strong> contactus@sahyadrihospitals.com
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Column 4: Social Media Links & Privacy (Requirement 3 & 7) -->
                    <div class="col-lg-3 col-md-6">
                        <h6 class="text-white fw-bold text-uppercase mb-3" style="letter-spacing: 1px; color: #f97316 !important;">
                            Connect With Us
                        </h6>
                        <p class="small text-light-50 mb-3">
                            Follow Sahyadri Hospital on social media for health tips, specialist talks, and wellness updates:
                        </p>
                        
                        <!-- Social Media Icon Buttons -->
                        <div class="footer-social-icons mb-3 d-flex gap-2">
                            <a href="https://www.facebook.com/SahyadriHospitals/" target="_blank" rel="noopener noreferrer" class="social-btn facebook" title="Facebook">
                                <i class="bi bi-facebook"></i>
                            </a>
                            <a href="https://www.instagram.com/sahyadri_hospitals/" target="_blank" rel="noopener noreferrer" class="social-btn instagram" title="Instagram">
                                <i class="bi bi-instagram"></i>
                            </a>
                            <a href="https://twitter.com/SahyadriHosp" target="_blank" rel="noopener noreferrer" class="social-btn twitter" title="Twitter / X">
                                <i class="bi bi-twitter-x"></i>
                            </a>
                            <a href="https://www.linkedin.com/company/sahyadri-hospitals-ltd/" target="_blank" rel="noopener noreferrer" class="social-btn linkedin" title="LinkedIn">
                                <i class="bi bi-linkedin"></i>
                            </a>
                        </div>

                        <div class="border-top border-secondary pt-3 mt-3">
                            <a asp-controller="Home" asp-action="Privacy" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                <i class="bi bi-shield-lock-fill text-warning me-1"></i> Privacy Policy &amp; DPDP
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Bottom Bar -->
                <div class="border-top border-secondary pt-3 mt-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-light-50">
                    <div>
                        &copy; 2026 Sahyadri Super Speciality Hospital (Pune, Maharashtra, India). All Rights Reserved.
                    </div>
                    <div class="d-flex gap-3">
                        <a asp-controller="Home" asp-action="Privacy" class="text-light-50 text-decoration-none hover-white">Privacy Policy</a>
                        <span>&bull;</span>
                        <a href="/#services" class="text-light-50 text-decoration-none hover-white">Specialties</a>
                        <span>&bull;</span>
                        <a href="/#doctors" class="text-light-50 text-decoration-none hover-white">Doctors Directory</a>
                        <span>&bull;</span>
                        <span class="text-warning">ABDM &amp; DPDP 2023 Compliant</span>
                    </div>
                </div>
            </div>
        </footer>
    }

    <!-- jQuery, Bootstrap, and Toastr Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Configure Toastr Defaults -->
    <script>
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": false,
            "onclick": null,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "4500",
            "extendedTimeOut": "1500",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        // Automatic Flash Message to Toastr Binding
        @if (TempData["SuccessMessage"] != null)
        {
            <text>toastr.success("@JavaScriptEncoder.Default.Encode(TempData["SuccessMessage"]?.ToString() ?? "")");</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>toastr.error("@JavaScriptEncoder.Default.Encode(TempData["ErrorMessage"]?.ToString() ?? "")");</text>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <text>toastr.info("@JavaScriptEncoder.Default.Encode(TempData["InfoMessage"]?.ToString() ?? "")");</text>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <text>toastr.warning("@JavaScriptEncoder.Default.Encode(TempData["WarningMessage"]?.ToString() ?? "")");</text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
