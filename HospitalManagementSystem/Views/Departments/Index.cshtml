@model IEnumerable<HospitalManagementSystem.Models.Department>
@{
    ViewData["Title"] = "Hospital Departments";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Hospital Clinical Departments</h4>
            <p class="text-muted small mb-0">Specialized medical units, facility locations, and department chairs</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-building-add"></i> Add Department
            </a>
        }
    </div>

    <div class="row g-4">
        @foreach (var dept in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card-modern p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="stat-icon primary"><i class="bi bi-building"></i></div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@dept.Name</h5>
                            <span class="badge bg-light text-primary">@dept.Doctors.Count Specialist(s)</span>
                        </div>
                    </div>

                    <p class="text-muted small mb-3 flex-grow-1">@dept.Description</p>

                    <div class="small text-muted mb-3">
                        <div><i class="bi bi-geo-alt text-secondary me-2"></i><strong>Location:</strong> @dept.Location</div>
                        <div><i class="bi bi-person-badge text-secondary me-2"></i><strong>Head:</strong> @dept.HeadOfDepartment</div>
                    </div>

                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <a asp-controller="Doctors" asp-action="Index" asp-route-departmentId="@dept.Id" class="small text-primary fw-semibold text-decoration-none">
                            View Doctors &rarr;
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

