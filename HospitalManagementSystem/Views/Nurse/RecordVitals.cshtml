@model HospitalManagementSystem.Models.PatientVital
@{
    ViewData["Title"] = "Record Patient Vitals";
    var patients = ViewBag.Patients as List<HospitalManagementSystem.Models.Patient> ?? new();
    var currentPatient = ViewBag.CurrentPatient as HospitalManagementSystem.Models.Patient;
}

<div class="container-fluid p-0">
    <div class="card-modern max-w-800 mx-auto" style="max-width: 800px;">
        <div class="card-header-modern">
            <h5 class="card-title-modern"><i class="bi bi-activity text-primary"></i> Record Patient Vitals (Nurse Station)</h5>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Station</a>
        </div>
        <div class="p-4">
            <form asp-action="RecordVitals" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="PatientId" class="form-label small fw-bold">Select Patient</label>
                    <select asp-for="PatientId" class="form-select" required>
                        <option value="">-- Choose Patient --</option>
                        @foreach (var pat in patients)
                        {
                            <option value="@pat.Id" selected="@(Model.PatientId == pat.Id)">
                                @pat.FullName (@pat.PatientCode) &bull; Blood: @pat.BloodGroup
                            </option>
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BloodPressure" class="form-label small fw-bold">Blood Pressure (mmHg)</label>
                        <input asp-for="BloodPressure" class="form-control" placeholder="120/80" required />
                        <small class="text-muted">Systolic / Diastolic</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="HeartRate" class="form-label small fw-bold">Heart Rate (bpm)</label>
                        <input asp-for="HeartRate" type="number" class="form-control" value="72" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Temperature" class="form-label small fw-bold">Body Temp (°F)</label>
                        <input asp-for="Temperature" type="number" step="0.1" class="form-control" value="98.6" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="OxygenSaturation" class="form-label small fw-bold">Oxygen SpO2 (%)</label>
                        <input asp-for="OxygenSaturation" type="number" step="0.1" class="form-control" value="98" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="RespiratoryRate" class="form-label small fw-bold">Respiratory Rate (breaths/min)</label>
                        <input asp-for="RespiratoryRate" type="number" class="form-control" value="16" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BloodSugar" class="form-label small fw-bold">Blood Glucose (mg/dL) - Optional</label>
                        <input asp-for="BloodSugar" type="number" step="0.1" class="form-control" placeholder="95" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="RecordedByNurse" class="form-label small fw-bold">Nurse In-Charge</label>
                        <input asp-for="RecordedByNurse" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label small fw-bold">Clinical Observations &amp; Remarks</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Patient condition, conscious state, reaction to medications..."></textarea>
                </div>

                <div class="mt-4 pt-2 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-check-circle"></i> Save Vital Measurements
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

