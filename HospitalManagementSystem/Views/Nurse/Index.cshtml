@model IEnumerable<HospitalManagementSystem.Models.BedAdmission>
@{
    ViewData["Title"] = "Nurse Station - Inpatient Care";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Nurse Station &amp; Inpatient Vitals</h4>
            <p class="text-muted small mb-0">Monitor admitted patients, record regular vital measurements and patient wellness</p>
        </div>
        <a asp-action="RecordVitals" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-activity"></i> Log Patient Vitals
        </a>
    </div>

    <!-- Admitted Patients List -->
    <div class="card-modern">
        <div class="card-header-modern">
            <h6 class="card-title-modern"><i class="bi bi-hospital text-danger"></i> Current Inpatients Under Nursing Care</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Bed / Ward</th>
                        <th>Patient</th>
                        <th>Admitted On</th>
                        <th>Latest Vitals</th>
                        <th>Last Checked</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No inpatients currently admitted.</td>
                        </tr>
                    }
                    @foreach (var adm in Model)
                    {
                        var latestVital = adm.Patient?.Vitals.OrderByDescending(v => v.RecordedAt).FirstOrDefault();
                        <tr>
                            <td>
                                <span class="badge bg-primary fs-6">@adm.Bed?.BedNumber</span>
                                <div class="small text-muted mt-1">@adm.Bed?.Ward?.WardName</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(adm.Patient?.FullName)</div>
                                <div class="small text-muted">Code: @adm.Patient?.PatientCode &bull; Blood: <span class="badge bg-danger-subtle text-danger">@adm.Patient?.BloodGroup</span></div>
                            </td>
                            <td>@adm.AdmissionDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (latestVital != null)
                                {
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-light text-dark border">BP: @latestVital.BloodPressure</span>
                                        <span class="badge bg-light text-dark border">HR: @latestVital.HeartRate</span>
                                        <span class="badge bg-light text-success border">SpO2: @latestVital.OxygenSaturation%</span>
                                        <span class="badge bg-light text-dark border">@latestVital.Temperature °F</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-circle me-1"></i>No vitals recorded</span>
                                }
                            </td>
                            <td>
                                @if (latestVital != null)
                                {
                                    <small class="text-muted">@latestVital.RecordedAt.ToString("MMM dd, hh:mm tt") by @latestVital.RecordedByNurse</small>
                                }
                                else
                                {
                                    <small class="text-muted">Pending intake</small>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="RecordVitals" asp-route-patientId="@adm.PatientId" class="btn btn-outline-custom" title="Record Vitals"><i class="bi bi-plus-circle me-1"></i>Vitals</a>
                                    <a asp-action="VitalsHistory" asp-route-id="@adm.PatientId" class="btn btn-outline-secondary" title="View Chart"><i class="bi bi-graph-up"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

