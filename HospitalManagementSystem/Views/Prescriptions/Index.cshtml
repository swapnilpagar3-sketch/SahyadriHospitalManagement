@model IEnumerable<HospitalManagementSystem.Models.Prescription>
@{
    ViewData["Title"] = "Prescriptions Directory";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Prescriptions &amp; Digital Pharmacy</h4>
            <p class="text-muted small mb-0">Doctor diagnostic orders, medicine regimens, dosage guidance and follow-ups</p>
        </div>
        @if (User.IsInRole("Doctor") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-file-earmark-plus"></i> Write Prescription
            </a>
        }
    </div>

    <!-- Prescriptions Cards / Table -->
    <div class="card-modern">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Diagnosis</th>
                        <th>Follow Up</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No prescriptions recorded yet.</td>
                        </tr>
                    }
                    @foreach (var rx in Model)
                    {
                        <tr>
                            <td>@rx.PrescribedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="fw-bold text-dark">@(rx.Patient?.FullName ?? "Unknown")</div>
                                <small class="text-muted">Code: @rx.Patient?.PatientCode</small>
                            </td>
                            <td>
                                <div>@(rx.Doctor?.User?.FullName ?? "Doctor")</div>
                                <small class="text-muted">@rx.Doctor?.Specialization</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@rx.Diagnosis</div>
                            </td>
                            <td>
                                @(rx.FollowUpDate.HasValue ? rx.FollowUpDate.Value.ToString("MMM dd, yyyy") : "None")
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@rx.Id" class="btn btn-sm btn-outline-custom">
                                    <i class="bi bi-printer"></i> View &amp; Print
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

