@model IEnumerable<HospitalManagementSystem.Models.Patient>
@{
    ViewData["Title"] = "Patients Directory";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Patients Directory</h4>
            <p class="text-muted small mb-0">Electronic Patient Registry, blood groups, and medical records</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-person-plus"></i> Register Patient
        </a>
    </div>

    <!-- Search & Filter Card -->
    <div class="card-modern p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, patient code, phone or email..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="bloodGroup" class="form-select">
                    <option value="All">All Blood Groups</option>
                    @foreach (var bg in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" })
                    {
                        <option value="@bg" selected="@(ViewBag.BloodGroup == bg)">@bg</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom w-100 justify-content-center">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>

    <!-- Patients Table -->
    <div class="card-modern">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Patient Name</th>
                        <th>Gender / Age</th>
                        <th>Blood Group</th>
                        <th>Contact</th>
                        <th>Emergency</th>
                        <th>Registered</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No patient records found.</td>
                        </tr>
                    }
                    @foreach (var patient in Model)
                    {
                        var age = DateTime.Today.Year - patient.DateOfBirth.Year;
                        <tr>
                            <td class="fw-bold text-primary">@patient.PatientCode</td>
                            <td>
                                <div class="fw-bold text-dark">@patient.FullName</div>
                                <small class="text-muted">@patient.Email</small>
                            </td>
                            <td>@patient.Gender, @age yrs</td>
                            <td>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">@patient.BloodGroup</span>
                            </td>
                            <td>@patient.Phone</td>
                            <td>
                                <div class="small">@patient.EmergencyContactName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@patient.EmergencyContactPhone</div>
                            </td>
                            <td>@patient.RegisteredAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-outline-secondary" title="Medical History"><i class="bi bi-file-medical"></i></a>
                                    <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@patient.Id" class="btn btn-outline-custom" title="Book Appointment"><i class="bi bi-calendar-plus"></i></a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@patient.Id" method="post" class="d-inline" onsubmit="return confirm('Delete patient @patient.FullName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

