@model HospitalManagementSystem.Models.Patient
@{
    ViewData["Title"] = "Register Patient";
}

<div class="container-fluid p-0">
    <div class="card-modern max-w-800 mx-auto" style="max-width: 800px;">
        <div class="card-header-modern">
            <h5 class="card-title-modern"><i class="bi bi-person-plus text-primary"></i> Register New Patient</h5>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Patients</a>
        </div>
        <div class="p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="PatientCode" class="form-label small fw-bold">Patient Code</label>
                        <input asp-for="PatientCode" class="form-control" readonly />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="FirstName" class="form-label small fw-bold">First Name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="John" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="LastName" class="form-label small fw-bold">Last Name</label>
                        <input asp-for="LastName" class="form-control" placeholder="Doe" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DateOfBirth" class="form-label small fw-bold">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Gender" class="form-label small fw-bold">Gender</label>
                        <select asp-for="Gender" class="form-select" required>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="BloodGroup" class="form-label small fw-bold">Blood Group</label>
                        <select asp-for="BloodGroup" class="form-select" required>
                            <option value="O+">O+</option>
                            <option value="A+">A+</option>
                            <option value="B+">B+</option>
                            <option value="AB+">AB+</option>
                            <option value="O-">O-</option>
                            <option value="A-">A-</option>
                            <option value="B-">B-</option>
                            <option value="AB-">AB-</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label small fw-bold">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="+1 (555) 000-0000" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="patient@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label small fw-bold">Residential Address</label>
                    <input asp-for="Address" class="form-control" placeholder="123 Health Ave, Suite 400" />
                </div>

                <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2 mt-4">Emergency &amp; Medical Background</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EmergencyContactName" class="form-label small fw-bold">Emergency Contact Name</label>
                        <input asp-for="EmergencyContactName" class="form-control" placeholder="Relative / Guardian Name" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EmergencyContactPhone" class="form-label small fw-bold">Emergency Contact Phone</label>
                        <input asp-for="EmergencyContactPhone" class="form-control" placeholder="+1 (555) 999-9999" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Allergies" class="form-label small fw-bold">Known Allergies / Medical Conditions</label>
                    <textarea asp-for="Allergies" class="form-control" rows="2" placeholder="e.g. Penicillin, Peanuts, Latex, Asthma"></textarea>
                </div>

                <div class="mt-4 pt-2 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-check-circle"></i> Save Patient Registration
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

