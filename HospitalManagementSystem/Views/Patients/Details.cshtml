@model HospitalManagementSystem.Models.Patient
@{
    ViewData["Title"] = "Patient Medical Record";
}

<div class="container-fluid p-0">
    <!-- Header Card -->
    <div class="card-modern p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon primary"><i class="bi bi-person-fill"></i></div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="fw-bold text-dark mb-0">@Model.FullName</h4>
                        <span class="badge bg-primary">@Model.PatientCode</span>
                        <span class="badge bg-danger">@Model.BloodGroup</span>
                    </div>
                    <p class="text-muted small mb-0 mt-1">
                        @Model.Gender &bull; Born @Model.DateOfBirth.ToString("MMM dd, yyyy") &bull; Phone: @Model.Phone &bull; Email: @Model.Email
                    </p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Nurse" asp-action="RecordVitals" asp-route-patientId="@Model.Id" class="btn btn-outline-custom btn-sm">
                    <i class="bi bi-activity"></i> Log Vitals (Nurse)
                </a>
                <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@Model.Id" class="btn btn-primary-custom btn-sm">
                    <i class="bi bi-calendar-plus"></i> Book Appointment
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Info Tabs -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card-modern p-3 h-100">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-exclamation-triangle text-danger me-1"></i> Allergies &amp; Alerts</h6>
                <div class="p-2 bg-light rounded text-danger fw-semibold small">
                    @(!string.IsNullOrEmpty(Model.Allergies) ? Model.Allergies : "No known drug allergies reported.")
                </div>
                <div class="mt-3 small text-muted">
                    <div><strong>Emergency Contact:</strong> @Model.EmergencyContactName</div>
                    <div><strong>Emergency Phone:</strong> @Model.EmergencyContactPhone</div>
                    <div><strong>Address:</strong> @Model.Address</div>
                </div>
            </div>
        </div>

        <!-- Latest Vitals from Nurse -->
        <div class="col-md-8">
            <div class="card-modern p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-activity text-info me-1"></i> Recent Vitals (Nurse Station)</h6>
                    <a asp-controller="Nurse" asp-action="VitalsHistory" asp-route-id="@Model.Id" class="small text-decoration-none">Full History</a>
                </div>
                @{
                    var latestVital = Model.Vitals.OrderByDescending(v => v.RecordedAt).FirstOrDefault();
                }
                @if (latestVital != null)
                {
                    <div class="row text-center g-2 mt-1">
                        <div class="col-3">
                            <div class="p-2 bg-light rounded">
                                <small class="text-muted d-block">Blood Pressure</small>
                                <span class="fw-bold text-dark">@latestVital.BloodPressure</span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 bg-light rounded">
                                <small class="text-muted d-block">Heart Rate</small>
                                <span class="fw-bold text-dark">@latestVital.HeartRate bpm</span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 bg-light rounded">
                                <small class="text-muted d-block">Oxygen (SpO2)</small>
                                <span class="fw-bold text-success">@latestVital.OxygenSaturation %</span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 bg-light rounded">
                                <small class="text-muted d-block">Temperature</small>
                                <span class="fw-bold text-dark">@latestVital.Temperature °F</span>
                            </div>
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        Recorded by @latestVital.RecordedByNurse on @latestVital.RecordedAt.ToString("MMM dd, yyyy hh:mm tt")
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0 mt-2">No vitals logged yet for this patient.</p>
                }
            </div>
        </div>
    </div>

    <!-- Appointments & Prescriptions Tabs -->
    <div class="card-modern">
        <div class="card-header-modern">
            <h6 class="card-title-modern"><i class="bi bi-journal-medical text-primary"></i> Clinical History</h6>
        </div>
        <div class="p-3">
            <ul class="nav nav-tabs" id="patientTab" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="appts-tab" data-bs-toggle="tab" data-bs-target="#appts" type="button">Appointments (@Model.Appointments.Count)</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="rx-tab" data-bs-toggle="tab" data-bs-target="#rx" type="button">Prescriptions (@Model.Prescriptions.Count)</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="inpatient-tab" data-bs-toggle="tab" data-bs-target="#inpatient" type="button">Bed Admissions (@Model.BedAdmissions.Count)</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="bills-tab" data-bs-toggle="tab" data-bs-target="#bills" type="button">Billing (@Model.Invoices.Count)</button>
                </li>
            </ul>

            <div class="tab-content pt-3" id="patientTabContent">
                <!-- Appointments Pane -->
                <div class="tab-pane fade show active" id="appts" role="tabpanel">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Doctor</th>
                                <th>Date &amp; Time</th>
                                <th>Symptoms</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.Appointments)
                            {
                                <tr>
                                    <td class="fw-bold">@appt.AppointmentCode</td>
                                    <td>@(appt.Doctor?.User?.FullName ?? "Doctor")</td>
                                    <td>@appt.AppointmentDate.ToString("MMM dd, yyyy") (@appt.TimeSlot)</td>
                                    <td>@appt.Symptoms</td>
                                    <td><span class="badge bg-light text-dark">@appt.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Prescriptions Pane -->
                <div class="tab-pane fade" id="rx" role="tabpanel">
                    @foreach (var rx in Model.Prescriptions)
                    {
                        <div class="p-3 border rounded mb-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-dark mb-0">Diagnosis: @rx.Diagnosis</h6>
                                <span class="small text-muted">@rx.PrescribedDate.ToString("MMM dd, yyyy") &bull; Dr. @(rx.Doctor?.User?.FullName)</span>
                            </div>
                            <div class="small fw-semibold text-secondary">Medicines:</div>
                            <pre class="bg-white p-2 rounded small border mb-2" style="white-space: pre-wrap;">@rx.Medicines</pre>
                            <div class="small text-muted"><strong>Advice:</strong> @rx.AdviceInstructions</div>
                        </div>
                    }
                </div>

                <!-- Bed Admissions Pane -->
                <div class="tab-pane fade" id="inpatient" role="tabpanel">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Ward / Bed</th>
                                <th>Admission Date</th>
                                <th>Discharge Date</th>
                                <th>Reason</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var adm in Model.BedAdmissions)
                            {
                                <tr>
                                    <td class="fw-bold">@adm.Bed?.Ward?.WardName (@adm.Bed?.BedNumber)</td>
                                    <td>@adm.AdmissionDate.ToString("MMM dd, yyyy")</td>
                                    <td>@(adm.DischargeDate.HasValue ? adm.DischargeDate.Value.ToString("MMM dd, yyyy") : "Currently Inpatient")</td>
                                    <td>@adm.Reason</td>
                                    <td><span class="badge @(adm.Status == "Admitted" ? "bg-warning text-dark" : "bg-success")">@adm.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Billing Pane -->
                <div class="tab-pane fade" id="bills" role="tabpanel">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Total</th>
                                <th>Paid</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Invoices)
                            {
                                <tr>
                                    <td class="fw-bold">@inv.InvoiceNumber</td>
                                    <td>₹@inv.TotalAmount</td>
                                    <td class="text-success">₹@inv.PaidAmount</td>
                                    <td><span class="badge @(inv.PaymentStatus == "Paid" ? "bg-success" : "bg-danger")">@inv.PaymentStatus</span></td>
                                    <td>@inv.InvoiceDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

