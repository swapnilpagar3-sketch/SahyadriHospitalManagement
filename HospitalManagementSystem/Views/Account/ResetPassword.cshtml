@model HospitalManagementSystem.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Enter New Password";
    Layout = "_Layout";
}

<div class="auth-bg">
    <div class="auth-card">
        <div class="auth-logo">
            <img src="~/images/hospital-logo.webp" alt="Sahyadri Hospital Logo" height="75" style="object-fit: contain; max-width: 280px;" />
            <h4 class="fw-bold text-dark mt-3 mb-1">Set New Password</h4>
            <p class="text-muted small">Sahyadri Hospital Patient &amp; Staff Account Recovery</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-secondary">Email Address</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Token" class="form-label small fw-bold text-secondary">Reset Code / Token</label>
                <input asp-for="Token" class="form-control font-monospace" placeholder="e.g. 8A3F29C1" required />
                <span asp-validation-for="Token" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-bold text-secondary">New Password</label>
                <input asp-for="NewPassword" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 justify-content-center py-2 mb-3">
                <i class="bi bi-shield-check"></i> Save New Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

