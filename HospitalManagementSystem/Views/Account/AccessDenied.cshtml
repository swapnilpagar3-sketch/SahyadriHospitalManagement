@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card-modern p-5 max-w-500 mx-auto" style="max-width: 520px;">
        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
        <h3 class="fw-bold text-dark mt-3">Access Denied</h3>
        <p class="text-muted">You do not have administrative or role-level permissions to access this specific hospital module.</p>
        <div class="mt-4">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary-custom">
                <i class="bi bi-house-door me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>

