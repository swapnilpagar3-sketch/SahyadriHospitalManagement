@{
    ViewData["Title"] = "Password Reset Initiated";
    Layout = "_Layout";
}

<div class="auth-bg">
    <div class="auth-card text-center">
        <div class="auth-logo">
            <img src="~/images/hospital-logo.webp" alt="Sahyadri Hospital Logo" height="75" style="object-fit: contain; max-width: 280px;" />
            <div class="my-4">
                <i class="bi bi-envelope-check text-success" style="font-size: 3.5rem;"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Check Your Email</h4>
            <p class="text-muted small">If your email is registered with Sahyadri Hospital, you will receive password reset instructions.</p>
        </div>
        <a asp-action="Login" class="btn btn-primary-custom w-100 justify-content-center">
            <i class="bi bi-box-arrow-in-right"></i> Return to Sign In
        </a>
    </div>
</div>

