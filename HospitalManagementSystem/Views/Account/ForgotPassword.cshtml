@model HospitalManagementSystem.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="auth-bg">
    <div class="auth-card">
        <div class="auth-logo">
            <img src="~/images/SahyadriLogo2.webp" alt="Sahyadri Hospital Logo" height="75" style="object-fit: contain; max-width: 280px;" />
            <h4 class="fw-bold text-dark mt-3 mb-1">Reset Sahyadri Password</h4>
            <p class="text-muted small">Enter your registered email to receive recovery instructions</p>
        </div>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-secondary">Registered Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="name@hospital.com" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 justify-content-center py-2 mb-3">
                <i class="bi bi-arrow-right-circle"></i> Send Password Reset Code
            </button>

            <div class="text-center mt-3">
                <a asp-action="Login" class="small text-decoration-none text-muted">
                    <i class="bi bi-arrow-left"></i> Back to Sign In
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

