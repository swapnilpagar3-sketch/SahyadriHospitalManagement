@{
    ViewData["Title"] = "Privacy Policy & Patient Data Protection";
}

<!-- Hero Header -->
<div class="py-5 text-white" style="background: linear-gradient(135deg, #042f2e 0%, #0f766e 50%, #0369a1 100%);">
    <div class="container py-3">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold mb-3">
                    <i class="bi bi-shield-lock-fill me-1"></i> DPDP ACT 2023 &amp; ABDM COMPLIANT
                </span>
                <h1 class="display-5 fw-extrabold mb-3">Sahyadri Hospital Privacy Policy</h1>
                <p class="lead text-light opacity-90 mb-0">
                    Comprehensive digital healthcare data privacy, patient electronic health records (EHR) confidentiality, and terms of medical information security across all Sahyadri Super Speciality Hospital units in Pune &amp; Maharashtra.
                </p>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="bg-white bg-opacity-10 backdrop-blur rounded-4 p-4 border border-white border-opacity-25 text-start shadow-sm">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <i class="bi bi-shield-check text-warning fs-1"></i>
                        <div>
                            <h6 class="fw-bold mb-0 text-white">NABH Digital Privacy</h6>
                            <small class="text-light opacity-75">Strict Patient Confidentiality</small>
                        </div>
                    </div>
                    <div class="small text-light opacity-90">
                        <i class="bi bi-geo-alt-fill text-warning me-1"></i> Sahyadri Hospital, Karve Road, Pune<br/>
                        <i class="bi bi-envelope-fill text-info me-1"></i> privacy@sahyadrihospitals.com
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="card-modern p-3 sticky-top" style="top: 90px;">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-list-nested text-teal me-1"></i> Policy Sections
                </h6>
                <nav class="nav nav-pills flex-column small gap-1">
                    <a class="nav-link text-dark py-2 px-3 rounded-3 active bg-teal text-white" href="#commitment">1. Commitment to Privacy</a>
                    <a class="nav-link text-dark py-2 px-3 rounded-3" href="#collection">2. Data We Collect</a>
                    <a class="nav-link text-dark py-2 px-3 rounded-3" href="#usage">3. Purpose of Clinical Data</a>
                    <a class="nav-link text-dark py-2 px-3 rounded-3" href="#consent">4. Patient Rights &amp; DPDP</a>
                    <a class="nav-link text-dark py-2 px-3 rounded-3" href="#security">5. EHR &amp; Lab Security</a>
                    <a class="nav-link text-dark py-2 px-3 rounded-3" href="#sharing">6. Insurance &amp; Government Portals</a>
                    <a class="nav-link text-dark py-2 px-3 rounded-3" href="#dpo">7. Data Protection Officer (DPO)</a>
                </nav>
            </div>
        </div>

        <!-- Policy Content -->
        <div class="col-lg-9">
            <div class="card-modern p-4 p-md-5 mb-4">
                <!-- Section 1 -->
                <section id="commitment" class="mb-5">
                    <span class="badge bg-teal-subtle text-teal fw-bold mb-2">Section 1</span>
                    <h3 class="fw-bold text-dark mb-3">1. Our Commitment to Patient Health Information</h3>
                    <p class="text-muted leading-relaxed">
                        At <strong>Sahyadri Super Speciality Hospital Ltd.</strong> ("Sahyadri Hospitals", "we", "us", or "our"), safeguarding your personal and medical information is integral to our clinical ethics. As a premier tertiary healthcare provider across Maharashtra, we strictly comply with:
                    </p>
                    <ul class="text-muted small">
                        <li>The <strong>Digital Personal Data Protection Act, 2023 (DPDP Act)</strong> of India.</li>
                        <li>The <strong>Ayushman Bharat Digital Mission (ABDM)</strong> guidelines for Electronic Health Records (EHR).</li>
                        <li>The <strong>Information Technology (Reasonable Security Practices and Procedures and Sensitive Personal Data or Information) Rules, 2011</strong>.</li>
                        <li>The <strong>National Accreditation Board for Hospitals &amp; Healthcare Providers (NABH)</strong> standards for clinical data integrity and patient rights.</li>
                    </ul>
                </section>

                <hr class="my-4" />

                <!-- Section 2 -->
                <section id="collection" class="mb-5">
                    <span class="badge bg-teal-subtle text-teal fw-bold mb-2">Section 2</span>
                    <h3 class="fw-bold text-dark mb-3">2. Information We Collect</h3>
                    <p class="text-muted">We collect information directly from you during registration, doctor consultations, diagnostic tests, ward admission, and digital portal usage:</p>
                    
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-person-vcard text-teal me-2"></i>Personal &amp; Contact Identifiers</h6>
                                <p class="small text-muted mb-0">Full name, mobile number, email address, date of birth, gender, residential address, emergency contact details, and government IDs (Aadhaar / ABHA ID where provided).</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <h6 class="fw-bold text-teal mb-2"><i class="bi bi-file-earmark-medical text-danger me-2"></i>Medical &amp; Clinical Records</h6>
                                <p class="small text-muted mb-0">Blood group, vitals (BP, pulse, blood sugar, SpO2), doctor prescriptions, clinical notes, surgical records, allergy history, and ward admissions.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-credit-card-2-front text-warning me-2"></i>Billing &amp; Insurance Details</h6>
                                <p class="small text-muted mb-0">Invoice history, payment transaction records, PM-JAY / Ayushman Bharat card details, Third-Party Administrator (TPA) claim numbers, and cashless mediclaim policy details.</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-camera text-info me-2"></i>Profile Media &amp; Photographs</h6>
                                <p class="small text-muted mb-0">Profile photographs uploaded during registration or profile updates to accurately verify patient/doctor identity on physical and digital wristbands and medical charts.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <hr class="my-4" />

                <!-- Section 3 -->
                <section id="usage" class="mb-5">
                    <span class="badge bg-teal-subtle text-teal fw-bold mb-2">Section 3</span>
                    <h3 class="fw-bold text-dark mb-3">3. How We Use Your Health Data</h3>
                    <p class="text-muted">Your data is utilized strictly for lawful healthcare delivery purposes:</p>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-start gap-2 small text-muted">
                            <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                            <div><strong>Direct Patient Care:</strong> Clinical diagnosis, prescription generation, nursing vitals monitoring, ICU management, and continuous care tracking.</div>
                        </div>
                        <div class="d-flex align-items-start gap-2 small text-muted">
                            <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                            <div><strong>Appointment &amp; Ward Scheduling:</strong> Managing real-time doctor slots, OPD schedules, bed reservations, and discharge summaries.</div>
                        </div>
                        <div class="d-flex align-items-start gap-2 small text-muted">
                            <i class="bi bi-check-circle-fill text-success fs-6 mt-1"></i>
                            <div><strong>Transparent Hospital Billing:</strong> Generating itemized GST-compliant invoices, processing UPI / card payments, and filing insurance pre-authorization requests.</div>
                        </div>
                    </div>
                </section>

                <hr class="my-4" />

                <!-- Section 4 -->
                <section id="consent" class="mb-5">
                    <span class="badge bg-teal-subtle text-teal fw-bold mb-2">Section 4</span>
                    <h3 class="fw-bold text-dark mb-3">4. Patient Rights under DPDP Act 2023</h3>
                    <p class="text-muted">Under Indian data protection laws, every Sahyadri Hospital patient possesses distinct rights:</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-eye text-teal me-1"></i> Right to Access &amp; Summary</div>
                                <div class="text-muted small">You can review your medical charts, past prescriptions, and paid invoices at any time via My Profile and Dashboard.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-pencil-square text-teal me-1"></i> Right to Correction</div>
                                <div class="text-muted small">You may update your profile photo, phone number, and address directly from the My Profile portal.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-x-circle text-teal me-1"></i> Right to Withdraw Consent</div>
                                <div class="text-muted small">Patients may revoke optional digital permissions by contacting our administration desk.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3">
                                <div class="fw-bold text-dark small mb-1"><i class="bi bi-telephone-inbound text-teal me-1"></i> Grievance Redressal</div>
                                <div class="text-muted small">Expedited redressal through our designated Hospital Data Protection Officer within stipulated timeframes.</div>
                            </div>
                        </div>
                    </div>
                </section>

                <hr class="my-4" />

                <!-- Section 5 -->
                <section id="security" class="mb-5">
                    <span class="badge bg-teal-subtle text-teal fw-bold mb-2">Section 5</span>
                    <h3 class="fw-bold text-dark mb-3">5. Electronic Medical Records &amp; Storage Security</h3>
                    <p class="text-muted">
                        We employ enterprise-grade security protocols:
                    </p>
                    <ul class="text-muted small">
                        <li><strong>Data Encryption:</strong> All sensitive patient identifiers and credentials are cryptographically hashed using BCrypt and encrypted in transit via SSL/TLS.</li>
                        <li><strong>Role-Based Access Control (RBAC):</strong> Strict compartmentalization ensures doctors access only assigned clinical records, wardens manage beds, and patients access their individual charts.</li>
                        <li><strong>Auditing &amp; Logging:</strong> Every clinical entry, admission, and prescription update is timestamped with verified staff IDs.</li>
                    </ul>
                </section>

                <hr class="my-4" />

                <!-- Section 6 -->
                <section id="sharing" class="mb-5">
                    <span class="badge bg-teal-subtle text-teal fw-bold mb-2">Section 6</span>
                    <h3 class="fw-bold text-dark mb-3">6. Empanelled Insurance &amp; Government Schemes</h3>
                    <p class="text-muted">
                        Sahyadri Hospitals participates in national public health welfare schemes including <strong>Ayushman Bharat (Pradhan Mantri Jan Arogya Yojana - PM-JAY)</strong>, <strong>Mahatma Jyotirao Phule Jan Arogya Yojana (MJPJAY)</strong>, and empanelled TPAs. Medical summaries and itemized bills are shared only as required to process your cashless health claims.
                    </p>
                </section>

                <hr class="my-4" />

                <!-- Section 7 -->
                <section id="dpo">
                    <span class="badge bg-warning text-dark fw-bold mb-2">Section 7</span>
                    <h3 class="fw-bold text-dark mb-3">7. Data Protection Officer (DPO) &amp; Grievances</h3>
                    <div class="card p-4 rounded-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #f0fdfa, #fff7ed); border-left: 5px solid #0f766e !important;">
                        <h6 class="fw-bold text-dark mb-2">Grievance Redressal Cell &bull; Sahyadri Hospitals</h6>
                        <p class="small text-muted mb-2">
                            For any inquiries, requests to exercise your data rights, or questions regarding our healthcare privacy practices:
                        </p>
                        <div class="small">
                            <div><strong>Designated DPO:</strong> Data Protection &amp; Medical Records Officer</div>
                            <div><strong>Hospital:</strong> Sahyadri Super Speciality Hospital</div>
                            <div><strong>Address:</strong> Plot No. 30-C, Erandwane, Karve Road, Deccan Gymkhana, Pune - 411004, Maharashtra, India</div>
                            <div><strong>Helpline:</strong> +91 20 6721 5000 / 1066</div>
                            <div><strong>Email:</strong> <a href="mailto:privacy@sahyadrihospitals.com" class="text-teal text-decoration-none fw-semibold">privacy@sahyadrihospitals.com</a></div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
