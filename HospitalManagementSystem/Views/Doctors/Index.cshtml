@model IEnumerable<HospitalManagementSystem.Models.Doctor>
@{
    ViewData["Title"] = "Doctors Directory";
    var departments = ViewBag.Departments as List<HospitalManagementSystem.Models.Department> ?? new();
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Doctors Directory</h4>
            <p class="text-muted small mb-0">Manage hospital specialists, consulting schedules, and qualifications</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-person-plus-fill"></i> Add New Doctor
            </a>
        }
    </div>

    <!-- Filter Bar -->
    <div class="card-modern p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by doctor name or specialization..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="departmentId" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Id" selected="@(ViewBag.SelectedDept == dept.Id)">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom w-100 justify-content-center">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>

    <!-- Doctors Cards / Grid -->
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">No doctors matched the filter criteria.</p>
            </div>
        }
        @foreach (var doc in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card-modern p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="@(doc.User?.ProfilePicture ?? "/images/avatars/doctor1.svg")" class="rounded-circle border border-2 border-teal" style="width: 64px; height: 64px; object-fit: cover;" />
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@(doc.User?.FullName ?? "Doctor")</h5>
                            <span class="badge bg-light text-primary">@doc.Specialization</span>
                            <div class="text-muted small mt-1">@doc.Department?.Name</div>
                        </div>
                    </div>

                    <div class="small text-muted mb-3 flex-grow-1">
                        <div class="mb-1"><i class="bi bi-mortarboard text-secondary me-2"></i><strong>Degree:</strong> @doc.Qualification</div>
                        <div class="mb-1"><i class="bi bi-clock-history text-secondary me-2"></i><strong>Experience:</strong> @doc.ExperienceYears years</div>
                        <div class="mb-1"><i class="bi bi-door-open text-secondary me-2"></i><strong>Room:</strong> @doc.RoomNumber</div>
                        <div class="mb-1"><i class="bi bi-calendar3 text-secondary me-2"></i><strong>Schedule:</strong> @doc.AvailableDays</div>
                        <div class="mb-1"><i class="bi bi-clock text-secondary me-2"></i><strong>Hours:</strong> @doc.AvailableTimeSlot</div>
                    </div>

                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <span class="h6 mb-0 text-success fw-bold">₹@doc.ConsultationFee / visit</span>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-outline-secondary" title="View Profile"><i class="bi bi-eye"></i></a>
                            <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@doc.Id" class="btn btn-outline-custom" title="Book Appointment"><i class="bi bi-calendar-plus"></i></a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@doc.Id" class="btn btn-outline-primary" title="Edit Doctor"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@doc.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this doctor record?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

