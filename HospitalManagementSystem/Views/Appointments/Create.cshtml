@model HospitalManagementSystem.Models.Appointment
@{
    ViewData["Title"] = "Book Appointment";
    var patients = ViewBag.Patients as List<HospitalManagementSystem.Models.Patient> ?? new();
    var doctors = ViewBag.Doctors as List<HospitalManagementSystem.Models.Doctor> ?? new();
}

<div class="container-fluid p-0">
    <div class="card-modern max-w-800 mx-auto" style="max-width: 800px;">
        <div class="card-header-modern">
            <h5 class="card-title-modern"><i class="bi bi-calendar-plus text-primary"></i> Book Patient Appointment</h5>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Appointments</a>
        </div>
        <div class="p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AppointmentCode" class="form-label small fw-bold">Appointment Reference</label>
                        <input asp-for="AppointmentCode" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label small fw-bold">Initial Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Scheduled">Scheduled</option>
                            <option value="Confirmed">Confirmed</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="PatientId" class="form-label small fw-bold">Select Patient</label>
                            <a asp-controller="Patients" asp-action="Create" target="_blank" class="small text-primary text-decoration-none">+ New Patient</a>
                        </div>
                        <select asp-for="PatientId" class="form-select" required>
                            <option value="">-- Choose Patient --</option>
                            @foreach (var pat in patients)
                            {
                                <option value="@pat.Id" selected="@(Model.PatientId == pat.Id)">@pat.FullName (@pat.PatientCode) - @pat.Phone</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DoctorId" class="form-label small fw-bold">Consulting Specialist</label>
                        <select asp-for="DoctorId" class="form-select" id="doctorSelect" required>
                            <option value="">-- Choose Specialist Doctor --</option>
                            @foreach (var doc in doctors)
                            {
                                <option value="@doc.Id" data-fee="@doc.ConsultationFee" selected="@(Model.DoctorId == doc.Id)">
                                    @(doc.User?.FullName ?? "Doctor") &bull; @doc.Specialization &bull; Fee: ₹@doc.ConsultationFee
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="AppointmentDate" class="form-label small fw-bold">Appointment Date</label>
                        <input asp-for="AppointmentDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TimeSlot" class="form-label small fw-bold">Time Slot</label>
                        <select asp-for="TimeSlot" class="form-select">
                            <option value="09:00 AM">09:00 AM</option>
                            <option value="09:30 AM">09:30 AM</option>
                            <option value="10:00 AM">10:00 AM</option>
                            <option value="10:30 AM">10:30 AM</option>
                            <option value="11:00 AM">11:00 AM</option>
                            <option value="11:30 AM">11:30 AM</option>
                            <option value="02:00 PM">02:00 PM</option>
                            <option value="02:30 PM">02:30 PM</option>
                            <option value="03:00 PM">03:00 PM</option>
                            <option value="03:30 PM">03:30 PM</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Fee" class="form-label small fw-bold">Consultation Fee (₹)</label>
                        <input asp-for="Fee" type="number" step="0.01" class="form-control" id="feeInput" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Symptoms" class="form-label small fw-bold">Chief Complaints / Symptoms</label>
                    <textarea asp-for="Symptoms" class="form-control" rows="3" placeholder="Describe symptoms, duration, and patient condition..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label small fw-bold">Doctor / Reception Notes (Optional)</label>
                    <input asp-for="Notes" class="form-control" placeholder="Special precautions or previous history notes" />
                </div>

                <div class="mt-4 pt-2 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-calendar-check"></i> Confirm Booking
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#doctorSelect').on('change', function () {
                const selectedOption = $(this).find('option:selected');
                const fee = selectedOption.attr('data-fee');
                if (fee) {
                    $('#feeInput').val(fee);
                }
            });
        });
    </script>
}

