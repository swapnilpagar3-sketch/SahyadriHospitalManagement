@model IEnumerable<HospitalManagementSystem.Models.BedAdmission>
@{
    ViewData["Title"] = "Inpatient Bed Admissions";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Inpatient Bed Admissions</h4>
            <p class="text-muted small mb-0">Active inpatient hospitalizations, admission records, and discharge summaries</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Admit" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-door-open"></i> Admit New Patient
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-grid"></i> Bed Grid
            </a>
        </div>
    </div>

    <!-- Admissions Table -->
    <div class="card-modern">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Ward / Bed</th>
                        <th>Admission Date</th>
                        <th>Discharge Date</th>
                        <th>Reason for Admission</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No admission records found.</td>
                        </tr>
                    }
                    @foreach (var adm in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@(adm.Patient?.FullName ?? "Unknown")</div>
                                <small class="text-muted">Code: @adm.Patient?.PatientCode &bull; Phone: @adm.Patient?.Phone</small>
                            </td>
                            <td>
                                <div class="fw-bold text-primary">@adm.Bed?.BedNumber</div>
                                <small class="text-muted">@adm.Bed?.Ward?.WardName (@adm.Bed?.Ward?.WardType)</small>
                            </td>
                            <td>@adm.AdmissionDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td>
                                @if (adm.DischargeDate.HasValue)
                                {
                                    <span>@adm.DischargeDate.Value.ToString("MMM dd, yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-warning fw-semibold"><i class="bi bi-clock me-1"></i>In Hospital</span>
                                }
                            </td>
                            <td>
                                <div class="small" style="max-width: 260px;">@adm.Reason</div>
                            </td>
                            <td>
                                <span class="badge @(adm.Status == "Admitted" ? "bg-warning text-dark" : "bg-success")">
                                    @adm.Status
                                </span>
                            </td>
                            <td>
                                @if (adm.Status == "Admitted")
                                {
                                    <form asp-action="Discharge" method="post" class="d-inline" onsubmit="return confirm('Discharge patient @adm.Patient?.FullName and release bed @adm.Bed?.BedNumber?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@adm.Id" />
                                        <input type="hidden" name="dischargeSummary" value="Patient recovered and discharged." />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-box-arrow-right"></i> Discharge
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Discharged</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

